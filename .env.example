# Старый способ. Теперь подписки и ключи добавляются командой «ninja add» или в окне
# и хранятся зашифрованными. Если .env заполнен, оттуда их один раз заберут в хранилище.
#
# Образец. Скопируй этот файл в .env (в той же папке) и вставь свою ссылку после «=».
# Файл .env не попадает в Git: секреты остаются только на твоём компьютере.

# Ссылка-подписка от VPN-сервиса (https://…/sub/…)
NINJA_SUBSCRIPTION_URL=

# Или один ключ vless://…, если подписки нет
NINJA_VLESS_KEY=
